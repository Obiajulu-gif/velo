# ─────────────────────────────────────────────────────────────────────────────
# Velo API — environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust for your target network.

PORT=3000

# --- Network ---
# Set to PUBLIC for Stellar Mainnet, TESTNET for Soroban testnet.
STELLAR_NETWORK=TESTNET
# Soroban RPC endpoint — change to https://soroban.stellar.org for mainnet.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- x402 Merchant ---
# Stellar address that receives x402 payment for API calls.
# Testnet: any test address.   Mainnet: the address that collects USDC fees.
MERCHANT_ADDRESS=G...YOUR_MERCHANT_ADDRESS

# --- Escrow contract registry ---
# Backward-compatible default contract. When set, it is registered as the active
# deployment for ESCROW_DEFAULT_SETTLEMENT_ASSET.
ESCROW_CONTRACT_ID=CAEYSVTKTCZYTSMPD7CU3NOFYOO4S5V6LJLGRNV7LKTNZ65N66PCHLMC
ESCROW_DEFAULT_SETTLEMENT_ASSET=USDC
ESCROW_CONTRACT_VERSION=1

# Optional legacy shortcut for a native-XLM escrow instance.
ESCROW_XLM_CONTRACT_ID=
ESCROW_XLM_CONTRACT_VERSION=1

# Operator-managed registry for additional assets and contract versions. This
# can be changed through deployment configuration without rebuilding the API.
# New trades use the highest-version `active` deployment for their requested
# settlement asset. Existing trades continue using their persisted contractId.
# A nested object with `testnet` and `mainnet` arrays is also accepted.
# Example:
# ESCROW_CONTRACT_REGISTRY_JSON=[{"deploymentId":"testnet-usdc-v2","network":"testnet","settlementAsset":"USDC","version":2,"contractId":"C...NEW_USDC","status":"active","replaces":"testnet-usdc-v1"},{"deploymentId":"testnet-usdc-v1","network":"testnet","settlementAsset":"USDC","version":1,"contractId":"C...OLD_USDC","status":"draining"},{"deploymentId":"testnet-xlm-v1","network":"testnet","settlementAsset":"XLM","version":1,"contractId":"C...XLM","status":"active"}]
ESCROW_CONTRACT_REGISTRY_JSON=

# Start-ledger override used by anomaly monitors for every active or draining
# escrow deployment.
ESCROW_MONITOR_START_LEDGER=

# --- Custodial Signer (TESTNET ONLY) ---
# Secret key used to sign escrow transactions on behalf of the buyer.
# ⚠️  This MUST be empty/unset on mainnet.  On PUBLIC network the API refuses
#    to use a custodial key and only supports the non-custodial flow
#    (POST /cash/request/prepare → client signs → POST /cash/request/submit).
BUYER_SECRET_KEY=S...YOUR_TESTNET_SECRET_KEY

# --- Fee Sponsor (OPTIONAL) ---
# Secret key used to sponsor transaction fees for users without XLM.
# When set, the API will wrap user transactions in fee-bump transactions,
# allowing users to interact with the escrow contract without holding XLM.
# This works on both testnet and mainnet. If unset, users must pay their own fees.
# The sponsor account must have sufficient XLM to cover transaction fees.
SPONSOR_SECRET_KEY=

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5181

# --- Distributed trade chat ---
# Managed Redis connection used for cross-instance Pub/Sub and shared state.
REDIS_URL=redis://localhost:6379
# At least 32 random characters. Generate with: openssl rand -base64 48
CHAT_CAPABILITY_SECRET=
CHAT_CAPABILITY_TTL_SECONDS=3600
CHAT_HEARTBEAT_INTERVAL_MS=30000

# --- Admin ---
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# --- Refund Alerts ---
# Webhook URL for refund alerts (Slack or Discord). Leave empty to disable.
REFUND_WEBHOOK_URL=
